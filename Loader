local successReadme, readmeContent = pcall(function()
    return game:HttpGet("https://raw.githubusercontent.com/galolmedo1-svg/n00bgui-universal/main/README.text")
end)

if successReadme and readmeContent then
    local ScreenGui = Instance.new("ScreenGui")
    local Frame = Instance.new("Frame")
    local UIListLayout = Instance.new("UIListLayout")
    local Scroll = Instance.new("ScrollingFrame")

    ScreenGui.Name = "ReadmeViewer"
    ScreenGui.Parent = game:GetService("CoreGui") or game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

    Scroll.Size = UDim2.new(0, 500, 0, 300)
    Scroll.Position = UDim2.new(0.5, -250, 0.5, -150)
    Scroll.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    Scroll.Parent = ScreenGui

    UIListLayout.Parent = Scroll
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder

    for line in readmeContent:gmatch("[^\r\n]+") do
        local TextLabel = Instance.new("TextLabel")
        TextLabel.Parent = Scroll
        TextLabel.Size = UDim2.new(1, 0, 0, 30)
        TextLabel.BackgroundTransparency = 1
        TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        TextLabel.TextXAlignment = Enum.TextXAlignment.Left

        if line:find("#") then
            TextLabel.TextSize = 28
            TextLabel.Size = UDim2.new(1, 0, 0, 45)
            TextLabel.Font = Enum.Font.SourceSansBold
        else
            TextLabel.TextSize = 14
            TextLabel.Font = Enum.Font.SourceSans
        end

        TextLabel.Text = line
    end

    task.wait(4)
    ScreenGui:Destroy()
end
loadstring(game:HttpGet("https://raw.githubusercontent.com/galolmedo1-svg/n00bgui-universal/main/n00bgui%20universal.text"))()
